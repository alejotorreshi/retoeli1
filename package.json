{
  "name": "registro-proveedor",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.3"
  },
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "NODE_ENV=development bun --watch src/server.ts",
    "dev:web": "bun --bun vite --config web/vite.config.ts --configLoader native",
    "build:web": "bun --bun vite build --config web/vite.config.ts --configLoader native",
    "start": "bun src/server.ts",
    "demo": "bun run demo.ts",
    "test": "bun test",
    "test:vivo": "LLM_EN_VIVO=1 bun test tests/live",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "audit": "bun audit --audit-level=moderate",
    "check": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && biome check . && bun audit --audit-level=moderate"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "hono": "4.13.13",
    "pdf-lib": "1.17.1",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eventsource-parser": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
